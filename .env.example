# ---- apps/api (FastAPI) -------------------------------------------------
# Comma-free JSON list of allowed browser origins.
HYPERSIGNAL_CORS_ORIGINS=["http://localhost:5173"]
# Seconds a parsed feed is served from memory before being re-fetched.
HYPERSIGNAL_FEED_CACHE_TTL_SECONDS=240
# Upstream request timeout in seconds.
HYPERSIGNAL_FEED_TIMEOUT_SECONDS=10
# Maximum feed body size in bytes (default 5 MiB).
HYPERSIGNAL_FEED_MAX_BYTES=5242880
# Optional allowlist of feed hosts. Empty list = any public host.
# Example: ["rss.app","hnrss.org"]
HYPERSIGNAL_FEED_ALLOWED_HOSTS=[]
# User-Agent sent to upstream feeds (Reddit blocks generic agents).
HYPERSIGNAL_USER_AGENT=hypersignal/0.1 (+https://github.com/haxybaxy/hypersignal)

# ---- apps/web (Vite) ----------------------------------------------------
# Base URL for the API. Defaults to /api, which the Vite dev server and the
# nginx container both proxy to the FastAPI app.
# VITE_API_BASE_URL=/api
